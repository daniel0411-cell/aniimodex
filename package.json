{
  "name": "game-tools-station",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run sitemap:images && npm run images:check",
    "lint": "next lint",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "seo:indexnow:submit": "node scripts/submit-indexnow.mjs --submit",
    "test:privacy-no-ads": "ADSENSE_ENABLED=0 npm run build && ADSENSE_ENABLED=0 node scripts/check-privacy-no-ads.cjs",
    "data:audit": "node scripts/data-audit.mjs",
    "data:sync-wiki": "node scripts/sync-official-wiki.mjs",
    "data:sync-wiki-details": "node scripts/sync-official-wiki-details.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pages:build": "next build && npm run sitemap:images && npm run images:check",
    "pages:dev": "npx serve@latest out",
    "sitemap:images": "node scripts/enrich-image-sitemap.mjs",
    "images:check": "node --test scripts/enrich-image-sitemap.test.mjs && node scripts/check-editorial-images.mjs"
  },
  "dependencies": {
    "next": "^14.2.15",
    "next-intl": "^4.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.12.0"
}
